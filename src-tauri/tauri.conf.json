{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Android Tools",
  "version": "2026.10.1",
  "identifier": "com.example.androidTools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Android Tools",
        "width": 1120,
        "height": 780,
        "minWidth": 680,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://*.sentry.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleVersion": "37",
      "minimumSystemVersion": "10.13"
    },
    "category": "DeveloperTool",
    "shortDescription": "Inspect connected Android devices"
  }
}
