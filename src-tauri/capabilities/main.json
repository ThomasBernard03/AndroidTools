{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window",
  "windows": ["main"],
  "permissions": [
    "allow-list-devices",
    "allow-stop-adb-server",
    "allow-get-device-info",
    "allow-read-logcat",
    "allow-clear-logcat",
    "allow-analyze-apk",
    "allow-generate-keystore",
    "allow-sign-apk",
    "allow-list-recent-apks",
    "allow-remove-recent-apk",
    "allow-list-files",
    "allow-preview-file",
    "allow-download-entry",
    "allow-upload-entry",
    "allow-create-directory",
    "allow-delete-entry",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
